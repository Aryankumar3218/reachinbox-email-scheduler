PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL via Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler?schema=public"

# Redis Configuration (BullMQ & Rate Limiting)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Worker Concurrency & Provider Throttling
WORKER_CONCURRENCY=5
DEFAULT_DELAY_BETWEEN_EMAILS_SECONDS=2
DEFAULT_HOURLY_LIMIT_PER_SENDER=20

# Ethereal SMTP Credentials (auto-generated if empty)
ETHEREAL_USER=""
ETHEREAL_PASS=""

# Elasticsearch Configuration
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_INDEX="emails"

# Slack OAuth / Notification Settings
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:5000/api/slack/oauth/callback"
SLACK_WEBHOOK_URL=""

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
